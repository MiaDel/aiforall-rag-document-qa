# ==============================================================================
# Environment Configuration Template for Multi-Document RAG Chatbot
# ==============================================================================

# System Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ChromaDB Collection Variables
CHROMA_PERSIST_DIRECTORY=data/chroma_db
COLLECTION_NAME=loan_contracts

# Chunking Size Thresholds
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval & Gating Parameters
TOP_K=5
SIMILARITY_THRESHOLD=0.5

# Neural Models
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# local Ollama Parameters
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# API Key Credentials
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here
